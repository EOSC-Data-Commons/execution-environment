{
  "@context": [
    "https://w3id.org/codemeta/3.0",
    "https://w3id.org/software-types",
    "https://eosc-data-commons.github.io/execution-environment/context.jsonld",
    { "schema": "https://schema.org/" }
  ],
  "@id": "https://github.com/example/containerised-service",
  "@type": "SoftwareSourceCode",
  "name": "Example containerised service",
  "codeRepository": "https://github.com/example/containerised-service",
  "runtimePlatform": [
    {
      "@id": "#container-environment",
      "@type": [
        "DockerEnvironment",
        "OCIEnvironment"
      ],
      "name": "Docker and OCI environment",
      "schema:hasPart": {
        "@id": "https://github.com/example/containerised-service/blob/main/Dockerfile"
      },
      "schema:url": {
        "@id": "https://ghcr.io/example/containerised-service"
      }
    }
  ],
  "isSourceCodeOf": {
    "@id": "#image",
    "@type": "SoftwareImage",
    "name": "Example OCI image"
  }
}
